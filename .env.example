# Keycloak / OIDC Configuration
KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/jungle
KEYCLOAK_CLIENT_ID=jungle-api
KEYCLOAK_CLIENT_SECRET=change-me-in-production
KEYCLOAK_AUDIENCE=jungle-api
JWK_CACHE_TTL=3600

# Database (jungle-db container)
DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet
DB_PASSWORD=wallet
DB_NAME=jungle

# SQS (MiniStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_POLLING_INTERVAL_MS=1000
SQS_VISIBILITY_TIMEOUT=30

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
